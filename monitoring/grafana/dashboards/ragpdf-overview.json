{
  "id": null,
  "uid": "ragpdf-overview",
  "title": "RAGPDF Infrastructure Overview",
  "tags": [
    "ragpdf",
    "kubernetes",
    "ec2",
    "overview"
  ],
  "timezone": "browser",
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "title": "🖥️ EC2 Instance Status",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "up{job=\"ec2-node-exporter\"}",
          "refId": "A"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "text": {},
        "textMode": "value_and_name"
      },
      "fieldConfig": {
        "defaults": {
          "mappings": [
            {
              "type": "value",
              "value": "0",
              "text": "DOWN"
            },
            {
              "type": "value",
              "value": "1",
              "text": "UP"
            }
          ],
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "red"
              },
              {
                "value": 1,
                "color": "green"
              }
            ]
          },
          "color": {
            "mode": "thresholds"
          }
        }
      }
    },
    {
      "id": 2,
      "title": "💻 CPU Usage",
      "type": "gauge",
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\",job=\"ec2-node-exporter\"}[5m])) * 100)",
          "refId": "A",
          "legendFormat": "CPU"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 70,
                "color": "yellow"
              },
              {
                "value": 85,
                "color": "red"
              }
            ]
          },
          "max": 100,
          "min": 0
        }
      }
    },
    {
      "id": 3,
      "title": "🧠 Memory Usage",
      "type": "gauge",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes{job=\"ec2-node-exporter\"} / node_memory_MemTotal_bytes{job=\"ec2-node-exporter\"})) * 100",
          "refId": "A",
          "legendFormat": "Memory"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 75,
                "color": "yellow"
              },
              {
                "value": 90,
                "color": "red"
              }
            ]
          },
          "max": 100,
          "min": 0
        }
      }
    },
    {
      "id": 4,
      "title": "💾 Disk Usage",
      "type": "gauge",
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "expr": "(1 - (node_filesystem_avail_bytes{job=\"ec2-node-exporter\",mountpoint=\"/\"} / node_filesystem_size_bytes{job=\"ec2-node-exporter\",mountpoint=\"/\"})) * 100",
          "refId": "A",
          "legendFormat": "Disk"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 80,
                "color": "yellow"
              },
              {
                "value": 90,
                "color": "red"
              }
            ]
          },
          "max": 100,
          "min": 0
        }
      }
    },
    {
      "id": 5,
      "title": "📈 CPU Usage Over Time",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\",job=\"ec2-node-exporter\"}[5m])) * 100)",
          "refId": "A",
          "legendFormat": "CPU %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "showPoints": "never"
          },
          "max": 100,
          "min": 0
        }
      }
    },
    {
      "id": 6,
      "title": "📊 Memory Usage Over Time",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "(1 - (node_memory_MemAvailable_bytes{job=\"ec2-node-exporter\"} / node_memory_MemTotal_bytes{job=\"ec2-node-exporter\"})) * 100",
          "refId": "A",
          "legendFormat": "Memory %"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 20,
            "showPoints": "never"
          },
          "max": 100,
          "min": 0
        }
      }
    },
    {
      "id": 7,
      "title": "☸️ Kubernetes Pods Status",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "expr": "count(kube_pod_status_phase{phase=\"Running\"})",
          "refId": "A",
          "legendFormat": "Running"
        },
        {
          "expr": "count(kube_pod_status_phase{phase=\"Pending\"})",
          "refId": "B",
          "legendFormat": "Pending"
        },
        {
          "expr": "count(kube_pod_status_phase{phase=\"Failed\"})",
          "refId": "C",
          "legendFormat": "Failed"
        }
      ],
      "options": {
        "reduceOptions": {
          "values": false,
          "calcs": [
            "lastNotNull"
          ]
        },
        "textMode": "value_and_name"
      }
    },
    {
      "id": 8,
      "title": "🔄 Pod Restarts (Last 1h)",
      "type": "stat",
      "gridPos": {
        "x": 8,
        "y": 12,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "expr": "sum(increase(kube_pod_container_status_restarts_total[1h]))",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": 0,
                "color": "green"
              },
              {
                "value": 1,
                "color": "yellow"
              },
              {
                "value": 5,
                "color": "red"
              }
            ]
          }
        }
      }
    },
    {
      "id": 9,
      "title": "📦 Deployments Status",
      "type": "table",
      "gridPos": {
        "x": 16,
        "y": 12,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "expr": "kube_deployment_status_replicas_available",
          "refId": "A",
          "format": "table",
          "instant": true
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true,
              "__name__": true,
              "job": true,
              "instance": true
            },
            "renameByName": {
              "namespace": "Namespace",
              "deployment": "Deployment",
              "Value": "Available"
            }
          }
        }
      ]
    },
    {
      "id": 10,
      "title": "🌐 Network Traffic",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "rate(node_network_receive_bytes_total{job=\"ec2-node-exporter\",device!~\"lo|veth.*\"}[5m]) * 8",
          "refId": "A",
          "legendFormat": "RX {{device}}"
        },
        {
          "expr": "rate(node_network_transmit_bytes_total{job=\"ec2-node-exporter\",device!~\"lo|veth.*\"}[5m]) * 8",
          "refId": "B",
          "legendFormat": "TX {{device}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10,
            "showPoints": "never"
          }
        }
      }
    },
    {
      "id": 11,
      "title": "⏱️ System Load Average",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "expr": "node_load1{job=\"ec2-node-exporter\"}",
          "refId": "A",
          "legendFormat": "1m"
        },
        {
          "expr": "node_load5{job=\"ec2-node-exporter\"}",
          "refId": "B",
          "legendFormat": "5m"
        },
        {
          "expr": "node_load15{job=\"ec2-node-exporter\"}",
          "refId": "C",
          "legendFormat": "15m"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 0,
            "showPoints": "never"
          }
        }
      }
    }
  ],
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "timepicker": {
    "refresh_intervals": [
      "5s",
      "10s",
      "30s",
      "1m",
      "5m",
      "15m",
      "30m",
      "1h",
      "2h",
      "1d"
    ]
  }
}